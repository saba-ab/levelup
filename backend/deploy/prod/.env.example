# Production secrets for deploy/prod/compose.yaml. Copy to .env on the host
# (chmod 600) and fill with generated values: openssl rand -hex 32
LEVELUP_IMAGE_TAG=latest

POSTGRES_USER=levelup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=levelup
RABBIT_USER=levelup
RABBIT_PASS=change-me

APP_ENV=prod
MODULES_ENABLED=identity,player,eventcatalog,program,points,badges,progression,streaks,missions,rewards,leaderboards,activity,rules
HTTP_ADDR=:8080
HTTP_ADMIN_ADDR=:8081
HTTP_RATE_LIMIT_PER_MINUTE=600
HTTP_CORS_ALLOWED_ORIGINS=https://portal.levelupos.ge

# Writer through PgBouncer (transaction pooling); reader and migrations direct.
DB_WRITER_DSN=postgres://levelup:change-me@pgbouncer:5432/levelup?sslmode=disable
DB_READER_DSN=postgres://levelup:change-me@postgres:5432/levelup?sslmode=disable
DB_MIGRATE_DSN=postgres://levelup:change-me@postgres:5432/levelup?sslmode=disable
DB_MAX_CONNS=8

JWT_SECRET=change-me-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

REDIS_CORE_ADDR=redis-core:6379
REDIS_CACHE_ADDR=redis-cache:6379

RABBIT_URL=amqp://levelup:change-me@rabbitmq:5672/
RABBIT_MGMT_URL=http://rabbitmq:15672
RABBIT_MGMT_USER=levelup
RABBIT_MGMT_PASS=change-me

OUTBOX_MAX_PUBLISH_ATTEMPTS=10
HTTP_TRUSTED_PROXIES=172.29.0.0/24

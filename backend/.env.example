# Copy to .env for local development. Every value here maps to deploy/compose.yaml.
APP_ENV=local
# Comma-separated, in dependency order (a consumer after its providers).
MODULES_ENABLED=identity,player,eventcatalog,program,points,badges,progression,streaks,missions,rewards,leaderboards,activity,rules

HTTP_ADDR=:8080
HTTP_ADMIN_ADDR=:8081

# Writer goes through PgBouncer (transaction pooling — hence PrepareStmt:false, §15).
# Reader and migrations connect direct: SET search_path is unsafe through a
# transaction pooler, and goose needs it.
DB_WRITER_DSN=postgres://app:app@localhost:6432/app?sslmode=disable
DB_READER_DSN=postgres://app:app@localhost:15432/app?sslmode=disable
DB_MIGRATE_DSN=postgres://app:app@localhost:15432/app?sslmode=disable
DB_MAX_CONNS=8

JWT_SECRET=local-dev-secret-change-me-32bytes!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

REDIS_CORE_ADDR=localhost:6380
REDIS_CACHE_ADDR=localhost:6381

RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_MGMT_URL=http://localhost:15672
RABBIT_MGMT_USER=guest
RABBIT_MGMT_PASS=guest

# Rate limit per principal (or IP when anonymous). Raise for load tests.
HTTP_RATE_LIMIT_PER_MINUTE=600

# Browser origins allowed to call the API (frontend/portal dev server by default).
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Broker nacks per outbox row before the dispatcher parks it in outbox_svc.dead_letters (R23).
OUTBOX_MAX_PUBLISH_ATTEMPTS=10

# ---- Module settings (all optional; defaults shown) ----
# IDENTITY_BCRYPT_COST=12
# IDENTITY_ALLOW_SELF_SIGNUP=true
# PLAYER_CACHE_TTL=5m
# PLAYER_PURGE_BATCH_SIZE=500
# PROGRAM_AUTO_END_SCHEDULE="*/5 * * * *"
# POINTS_RECONCILE_SCHEDULE="*/15 * * * *"
# BADGES_RECONCILE_SCHEDULE="0 * * * *"
# PROGRESSION_RECONCILE_SCHEDULE="0 * * * *"
# PROGRESSION_RECONCILE_REPLACE_LEVELS=false
# STREAKS_BREAK_SWEEP_SCHEDULE="5 * * * *"
# STREAKS_PRUNE_SCHEDULE="30 3 * * *"
# MISSIONS_EXPIRE_SWEEP_SCHEDULE="*/5 * * * *"
# REWARDS_HOLD_TTL=10m
# REWARDS_CLAIMS_RECONCILE_SCHEDULE="* * * * *"
# REWARDS_CLAIMS_EXPIRE_SCHEDULE="0 * * * *"
# LEADERBOARDS_ROLLOVER_SCHEDULE="5 * * * *"
# LEADERBOARDS_REBUILD_SCHEDULE="30 3 * * *"
# ACTIVITY_REQUIRE_KNOWN_EVENT_TYPE=true
# ACTIVITY_AUTO_CREATE_PLAYERS=false
# ACTIVITY_INTERNAL_TRIGGERS=false
# ACTIVITY_MAX_AGE=720h
# ACTIVITY_STUCK_AFTER=5m

# ---- Tests without Docker (task test:pg) ----
# PGTEST_DSN=postgres://you@localhost:5432/postgres?sslmode=disable   # user must be allowed CREATE DATABASE
# REDISTEST_ADDR=localhost:16399   # a THROWAWAY redis-server; tests write freely

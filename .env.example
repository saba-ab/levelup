# Copy to .env for local development. Every value here maps to deploy/compose.yaml.
APP_ENV=local
# Comma-separated, in dependency order. Empty is a valid, empty registry: the
# template ships no business modules. Add names as you scaffold modules.
MODULES_ENABLED=

HTTP_ADDR=:8080
HTTP_ADMIN_ADDR=:8081

# Writer goes through PgBouncer (transaction pooling — hence PrepareStmt:false, §15).
# Reader and migrations connect direct: SET search_path is unsafe through a
# transaction pooler, and goose needs it.
DB_WRITER_DSN=postgres://app:app@localhost:6432/app?sslmode=disable
DB_READER_DSN=postgres://app:app@localhost:15432/app?sslmode=disable
DB_MIGRATE_DSN=postgres://app:app@localhost:15432/app?sslmode=disable
DB_MAX_CONNS=8

JWT_SECRET=local-dev-secret-change-me-32bytes!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

REDIS_CORE_ADDR=localhost:6380
REDIS_CACHE_ADDR=localhost:6381

RABBIT_URL=amqp://guest:guest@localhost:5672/
RABBIT_MGMT_URL=http://localhost:15672
RABBIT_MGMT_USER=guest
RABBIT_MGMT_PASS=guest

# Rate limit per principal (or IP when anonymous). Raise for load tests.
HTTP_RATE_LIMIT_PER_MINUTE=600

# Broker nacks per outbox row before the dispatcher parks it in outbox_svc.dead_letters (R23).
OUTBOX_MAX_PUBLISH_ATTEMPTS=10

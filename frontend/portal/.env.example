# LevelUpOS API Configuration
# All environment variables must be prefixed with VITE_ to be accessible in the client

# Production API URL
VITE_API_URL_PRODUCTION=https://api.levelupos.ge

# Staging API URL
VITE_API_URL_STAGING=https://staging-api.levelupos.ge

# Development API URL
VITE_API_URL_DEVELOPMENT=https://dev-api.levelupos.ge

# Localhost API URL: the Go API (backend: task run). Routes already include /api/v1.
VITE_API_URL_LOCALHOST=http://localhost:8080

# Default API URL (used as fallback)
VITE_API_URL_DEFAULT=https://api.levelupos.ge

# App Configuration
VITE_APP_NAME=LevelUpOS Manager
VITE_APP_ENV=development